package ${package}.${moduleName}.controller;

import java.util.Arrays;
import java.util.Map;

import org.springframework.web.bind.annotation.*;

import javax.annotation.Resource;
import java.util.Arrays;
import java.util.Map;

/**
 * ${comments}
 *
 * @author ${author}
 * @email ${email}
 * @date ${datetime}
 */
@RestController
@RequestMapping("${moduleName}/${pathName}")
public class ${className}Controller {
    @Resource(name="${classname}ServiceImpl")
    private ${className}Service ${classname}Service;

    /**
     * 关键字查询
     */
    @PostMapping("/query")
    public R query(@RequestBody ${className}Entity ${classname}){
        return R.ok().setData(${classname}Service.query(${classname}));
    }

    /**
     * 分页列表
     */
    @GetMapping("/list")
    public R list(@RequestParam Map<String, Object> params){
        PageUtils page = ${classname}Service.queryPage(params);
        return R.ok().put("page", page);
    }

    /**
     * 详情
     */
    @GetMapping("/info/{${pk.columnName}}")
    public R info(@PathVariable("${pk.columnName}") ${pk.attrType} ${pk.columnName}){
		${className}Entity ${classname} = ${classname}Service.getById(${pk.columnName});
        return R.ok().setData(${classname});
    }

    /**
     * 保存
     */
    @PostMapping("/save")
    public R save(@RequestBody ${className}Entity ${classname}){
		${classname}Service.save(${classname});
        return R.ok().setData(${classname});
    }

    /**
     * 修改
     */
    @PostMapping("/update")
    public R update(@RequestBody ${className}Entity ${classname}){
		${classname}Service.updateById(${classname});
        return R.ok();
    }

    /**
     * 删除
     */
    @PostMapping("/delete")
    public R delete(@RequestBody ${pk.attrType}[] ${pk.columnName}s){
		${classname}Service.removeByIds(Arrays.asList(${pk.columnName}s));
        return R.ok();
    }

}
